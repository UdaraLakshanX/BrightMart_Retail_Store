	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<parameter name="P_INVOICE_NO" class="java.lang.String">
		<defaultValueExpression><![CDATA["INV-10045"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_CASHIER" class="java.lang.String">
		<defaultValueExpression><![CDATA["Admin"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_PAYMENT_MODE" class="java.lang.String">
		<defaultValueExpression><![CDATA["Cash"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_CASH_PAID" class="java.lang.Double">
		<defaultValueExpression><![CDATA[6500.00]]></defaultValueExpression>
	</parameter>
	<parameter name="P_BALANCE" class="java.lang.Double">
		<defaultValueExpression><![CDATA[500.00]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    i.invoice_no,
    i.invoice_date_time,
    i.total_amount,
    ii.item_code,
    COALESCE(p.description, ii.item_code) AS description,
    ii.sold_qty,
    ii.selling_price,
    (ii.sold_qty * ii.selling_price) AS line_total
FROM invoice i
INNER JOIN invoice_items ii ON i.invoice_no = ii.invoice_no
LEFT JOIN product p ON ii.item_code = p.item_code
WHERE i.invoice_no = $P{P_INVOICE_NO}
ORDER BY ii.item_code ASC]]>
	</queryString>
	<field name="invoice_no" class="java.lang.String"/>
	<field name="invoice_date_time" class="java.sql.Timestamp"/>
	<field name="total_amount" class="java.math.BigDecimal"/>
	<field name="item_code" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>
	<field name="sold_qty" class="java.lang.Integer"/>
	<field name="selling_price" class="java.math.BigDecimal"/>
	<field name="line_total" class="java.math.BigDecimal"/>
	<variable name="CALCULATED_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{line_total}]]></variableExpression>
	</variable>
